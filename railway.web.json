{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "cronSchedule": null,
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "startCommand": "gunicorn server:app --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 120 --access-logfile - --error-logfile -"
  }
}
